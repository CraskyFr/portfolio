---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Container from '../../components/Container.astro';
import Tag from '../../components/Tag.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Seules les missions phares ont une étude de cas détaillée.
export const getStaticPaths = (async () => {
  const experiences = await getCollection('experiences', ({ data }) => data.featured);
  return experiences.map((experience) => ({
    params: { slug: experience.id },
    props: { experience },
  }));
}) satisfies GetStaticPaths;

interface Props {
  experience: CollectionEntry<'experiences'>;
}

const { experience } = Astro.props;
const { data } = experience;
const { Content } = await render(experience);
const month = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' });
const period = `${month.format(data.start)} – ${data.end ? month.format(data.end) : "aujourd'hui"}`;
---

<BaseLayout title={data.client ?? data.company} description={data.summary}>
  <Container class="py-16 sm:py-20">
    <a href="/#experience" class="text-muted hover:text-accent text-sm transition-colors">
      ← Retour aux expériences
    </a>

    <header class="mt-8">
      <p class="text-accent font-mono text-sm">
        {period} · {data.location}
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {data.client ?? data.company}
      </h1>
      <p class="text-muted mt-2 text-lg">
        {data.role} · {data.company}
      </p>
      <p class="mt-6 text-lg leading-relaxed">{data.summary}</p>
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
        {data.stack.map((tech) => (
          <li>
            <Tag>{tech}</Tag>
          </li>
        ))}
      </ul>
    </header>

    <article class="prose prose-headings:tracking-tight mt-12 max-w-none">
      <Content />
    </article>
  </Container>
</BaseLayout>
