---
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable">
  <Container class="py-28 text-center">
    <p class="text-accent font-mono text-sm">HTTP 404 · Not Found</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Cette page n'existe pas</h1>
    <p class="text-muted mt-4">La ressource demandée est introuvable ou a été déplacée.</p>
    <div class="mt-8">
      <Button href="/">Retour à l'accueil</Button>
    </div>
  </Container>
</BaseLayout>
