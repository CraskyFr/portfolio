---
// Sommaire fixe dans la bande gauche (écran large uniquement) : la section en cours de
// lecture s'allume. Sur les écrans plus étroits, le menu du header suffit.
interface Props {
  sections: { id: string; title: string }[];
}

const { sections } = Astro.props;
---

<nav aria-label="Sommaire de la page" class="page-toc print:hidden">
  <ol class="border-border space-y-1 border-l">
    {sections.map((section) => (
      <li>
        <a href={`#${section.id}`} data-toc-link={section.id} class="page-toc-link">
          {section.title}
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  // La section active est celle qui traverse une bande au tiers supérieur de l'écran.
  // Cas particuliers : en haut de page (accroche), aucune ; tout en bas, la dernière section,
  // trop courte pour atteindre cette bande.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((link) => [
      link.dataset.tocLink,
      link,
    ]),
  );
  const ordered = [...links.values()];
  const firstSection = document.getElementById(ordered[0]?.dataset.tocLink ?? '');
  let current: HTMLAnchorElement | undefined;

  const activate = (link: HTMLAnchorElement | undefined) => {
    if (link === current) return;
    current?.removeAttribute('aria-current');
    link?.setAttribute('aria-current', 'true');
    current = link;
  };

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) activate(links.get(entry.target.id));
      }
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  for (const id of links.keys()) {
    const section = id && document.getElementById(id);
    if (section) observer.observe(section);
  }

  let frame = 0;
  addEventListener(
    'scroll',
    () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 4;
        const beforeFirst =
          firstSection && firstSection.getBoundingClientRect().top > innerHeight * 0.4;
        if (atBottom) activate(ordered.at(-1));
        else if (beforeFirst) activate(undefined);
      });
    },
    { passive: true },
  );
</script>
