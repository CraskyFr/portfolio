---
// Étude de cas d'une expérience : accroche, repères « En bref » et contenu Markdown.
// Sur la page dédiée, précédée de son en-tête ; dans la carte, l'en-tête est rendu par
// ExperienceItem (titre et sommaire fixes en haut de la carte).
import { render, type CollectionEntry } from 'astro:content';
import { periodOf, titleOf } from '../data/experience';
import Tag from './Tag.astro';

interface Props {
  experience: CollectionEntry<'experiences'>;
  /** Affiche l'en-tête (période, titre h1, poste) : page dédiée uniquement. */
  header?: boolean;
}

const { experience, header = true } = Astro.props;
const { data } = experience;
const { Content } = await render(experience);
const period = periodOf(experience);

// La période et le poste figurent déjà dans l'en-tête (page ou carte).
const facts = [
  { label: 'Équipe', value: data.team },
  { label: 'Méthode', value: data.method },
].filter((fact) => fact.value);
---

{header && (
  <header>
    <p class="text-accent font-mono text-sm">
      {period} · {data.location}
    </p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{titleOf(experience)}</h1>
    <p class="text-muted mt-2 text-lg">
      {data.role} · {data.company}
    </p>
  </header>
)}

<p class:list={['text-lg leading-relaxed', header && 'mt-6']}>{data.summary}</p>

<section id="en-bref" class="border-border mt-8 rounded-lg border p-5 sm:p-6">
  <h2 class="text-muted font-mono text-xs font-semibold tracking-widest uppercase">En bref</h2>
  <dl class="mt-4 grid gap-x-8 gap-y-4 sm:grid-cols-2">
    {facts.map((fact) => (
      <div>
        <dt class="text-muted text-sm">{fact.label}</dt>
        <dd class="mt-0.5 font-medium">{fact.value}</dd>
      </div>
    ))}
    <div class="sm:col-span-2">
      <dt class="text-muted text-sm">Environnement</dt>
      <dd class="mt-2">
        <ul class="flex flex-wrap gap-2">
          {(data.environment ?? data.stack).map((tech) => (
            <li>
              <Tag>{tech}</Tag>
            </li>
          ))}
        </ul>
      </dd>
    </div>
  </dl>
</section>

<article class="prose prose-headings:tracking-tight prose-h2:scroll-mt-6 mt-10 max-w-none">
  <Content />
</article>
