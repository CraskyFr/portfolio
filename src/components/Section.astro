---
import Container from './Container.astro';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="py-16">
  <Container>
    <h2
      id={`${id}-title`}
      class="text-muted after:bg-border flex items-center gap-4 font-mono text-xs font-semibold tracking-widest uppercase after:h-px after:flex-1"
    >
      {title}
    </h2>
    <div class="mt-10">
      <slot />
    </div>
  </Container>
</section>
