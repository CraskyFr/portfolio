---
// Schéma volontairement simplifié : aucune information interne au client.
const steps = [
  { title: 'Systèmes Maisons du Monde', detail: 'Canaux de vente, stocks, transport' },
  { title: 'Pub/Sub', detail: "Topics d'événements", accent: true },
  { title: 'Services de flux', detail: 'Java / Spring Boot sur GCP' },
  { title: 'OMS OneStock', detail: 'Orchestration des commandes' },
];
---

<figure class="not-prose my-10 leading-snug">
  <ol class="flex flex-col items-stretch gap-2 md:flex-row md:items-center">
    {steps.map((step, index) => (
      <>
        {index > 0 && (
          <li aria-hidden="true" class="text-muted text-center font-mono text-lg">
            <span class="md:hidden">⇅</span>
            <span class="hidden md:inline">⇄</span>
          </li>
        )}
        <li
          class:list={[
            'flex-1 rounded-lg border p-4 text-center',
            step.accent ? 'border-accent bg-accent-soft' : 'border-border bg-surface',
          ]}
        >
          <p class:list={['font-semibold', step.accent && 'text-accent']}>{step.title}</p>
          <p class="text-muted mt-1 text-sm">{step.detail}</p>
        </li>
      </>
    ))}
  </ol>
  <figcaption class="text-muted mt-4 text-center text-sm">
    Vue simplifiée des échanges : chaque système communique via des événements Pub/Sub, dans les
    deux sens.
  </figcaption>
</figure>
