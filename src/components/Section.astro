---
import Container from './Container.astro';

interface Props {
  id: string;
  title: string;
  /** Pastille affichée à côté du titre (ex. « En cours de construction »). */
  status?: string;
}

const { id, title, status } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="py-16">
  <Container>
    <h2
      data-reveal
      id={`${id}-title`}
      class="after:bg-border flex flex-wrap items-center gap-x-4 gap-y-2 text-2xl font-semibold tracking-tight after:h-px after:flex-1"
    >
      <span class="whitespace-nowrap">{title}</span>
      {status && (
        <span class="border-border text-muted inline-flex items-center rounded-full border border-dashed px-2.5 py-0.5 text-xs font-medium tracking-normal whitespace-nowrap">
          {status}
        </span>
      )}
    </h2>
    <div class="mt-10">
      <slot />
    </div>
  </Container>
</section>
