---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Button from '../components/Button.astro';
import Container from '../components/Container.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import Icon from '../components/Icon.astro';
import Section from '../components/Section.astro';
import Tag from '../components/Tag.astro';
import Typewriter from '../components/Typewriter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  about,
  domains,
  education,
  interests,
  languages,
  principles,
  projects,
  skills,
} from '../data/profile';
import { site } from '../data/site';
import photo from '../assets/photo/paul-bodin.jpg';

const experiences = (await getCollection('experiences')).sort(
  (a, b) => b.data.start.getTime() - a.data.start.getTime(),
);
// Études de cas voisines dans la frise (de la plus récente à la plus ancienne).
const caseStudies = experiences.filter((experience) => experience.data.featured);
const neighbours = (experience: (typeof experiences)[number]) => {
  const index = caseStudies.indexOf(experience);
  return index === -1 ? {} : { newer: caseStudies[index - 1], older: caseStudies[index + 1] };
};

// Arrivée sur la page : les lignes du haut s'écrivent l'une après l'autre, de plus en plus vite
// (le texte s'allonge), puis les boutons apparaissent.
const pause = 150;
let elapsed = 250;
const typing = (text: string, speed: number) => {
  const line = { text, speed, delay: elapsed };
  elapsed += text.length * speed + pause;
  return line;
};
const hero = {
  name: typing(site.name, 60),
  title: typing(site.title, 35),
  location: typing(site.location, 25),
  tagline: typing(site.tagline, 14),
};
const buttonsDelay = elapsed;
---

<BaseLayout>
  <Container class="pt-14 pb-8 sm:pt-20">
    <Image
      src={photo}
      alt={`Photo de ${site.name}`}
      width={224}
      loading="eager"
      class="intro border-border mb-6 size-24 rounded-full border object-cover object-[50%_20%] sm:size-28"
    />
    <Typewriter {...hero.name} as="h1" class="text-4xl font-bold tracking-tight sm:text-5xl" />
    <Typewriter {...hero.title} class="text-muted mt-2 text-xl sm:text-2xl" />
    <Typewriter {...hero.location} class="text-accent mt-2 font-mono text-sm" />
    <Typewriter {...hero.tagline} class="mt-6 max-w-2xl text-lg leading-relaxed" lastLine />
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href={site.cv} download class="intro" style={`--delay: ${buttonsDelay}ms`}>
        <Icon name="download" />
        Télécharger le CV
      </Button>
      <Button
        variant="secondary"
        href={site.links.linkedin}
        target="_blank"
        rel="noopener"
        class="intro"
        style={`--delay: ${buttonsDelay + 60}ms`}
      >
        <Icon name="linkedin" />
        LinkedIn
      </Button>
      <Button
        variant="secondary"
        href={site.links.github}
        target="_blank"
        rel="noopener"
        class="intro"
        style={`--delay: ${buttonsDelay + 120}ms`}
      >
        <Icon name="github" />
        GitHub
      </Button>
    </div>
  </Container>

  <Section id="experience" title="Expérience">
    <div class="relative">
      {/* Frise (à partir de sm) : rail discret et ligne qui se dessine au défilement. */}
      <span
        aria-hidden="true"
        class="bg-border absolute top-2 bottom-0 left-36 hidden w-px sm:block"
      ></span>
      <span
        aria-hidden="true"
        class="timeline-line bg-accent absolute top-2 bottom-0 left-36 hidden w-px sm:block"
      ></span>
      <ol class="space-y-14">
        {experiences.map((experience, index) => (
          <li data-reveal>
            <ExperienceItem
              experience={experience}
              eager={index === 0}
              {...neighbours(experience)}
            />
          </li>
        ))}
      </ol>
    </div>
  </Section>

  <Section id="competences" title="Compétences">
    <dl class="space-y-6">
      {skills.map((group) => (
        <div data-reveal class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-8">
          <dt class="text-muted font-mono text-sm sm:pt-0.5">{group.label}</dt>
          <dd>
            <ul class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li>
                  <Tag>{item}</Tag>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
      <div data-reveal class="grid gap-2 sm:grid-cols-[8rem_1fr] sm:gap-8">
        <dt class="text-muted font-mono text-sm">Fonctionnel</dt>
        <dd>{domains.join(' · ')}</dd>
      </div>
    </dl>
  </Section>

  <Section id="methode" title="Comment je travaille">
    <ol class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {principles.map((principle, index) => (
        <li data-reveal class="flex gap-4" style={`--delay: ${(index % 2) * 100}ms`}>
          <span aria-hidden="true" class="text-accent font-mono text-sm font-semibold">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="font-semibold">{principle.title}</h3>
            <p class="text-muted mt-1 leading-relaxed">{principle.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="projets" title="Projets personnels" status="En cours de construction">
    <p data-reveal class="text-muted -mt-4 mb-8 max-w-2xl text-sm leading-relaxed">
      Projets menés sur mon temps libre pour expérimenter. Ils évoluent régulièrement, et de
      nouveaux projets arriveront bientôt.
    </p>
    <ul class="grid gap-4 sm:grid-cols-2">
      {projects.map((project, index) => (
        <li
          data-reveal
          class="border-border bg-surface hover:border-accent/40 flex flex-col rounded-lg border p-5 transition-colors"
          style={`--delay: ${(index % 2) * 100}ms`}
        >
          <h3 class="font-semibold">{project.name}</h3>
          <p class="text-muted mt-2 flex-1 text-sm leading-relaxed">{project.description}</p>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
            {project.stack.map((tech) => (
              <li>
                <Tag>{tech}</Tag>
              </li>
            ))}
          </ul>
          {project.url && (
            <a
              href={project.url}
              target="_blank"
              rel="noopener"
              class="text-accent mt-5 inline-flex items-center gap-2 self-start text-sm font-medium hover:underline"
            >
              <Icon name="github" class="size-4" />
              Voir le code sur GitHub
              <span class="sr-only"> : {project.name} (nouvel onglet)</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <Section id="a-propos" title="À propos">
    <div data-reveal class="space-y-4 leading-relaxed">
      {about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <dl class="mt-10 grid gap-8 sm:grid-cols-3">
      <div data-reveal>
        <dt class="text-muted font-mono text-sm">Formation</dt>
        <dd class="mt-2">
          <p class="font-medium">{education.school}</p>
          <p class="text-muted text-sm">{education.degree}</p>
          <p class="text-muted text-sm">{education.period}</p>
        </dd>
      </div>
      <div data-reveal style="--delay: 100ms">
        <dt class="text-muted font-mono text-sm">Langues</dt>
        <dd class="mt-2">
          <ul class="space-y-1">
            {languages.map((language) => (
              <li>
                <span class="font-medium">{language.name}</span>
                <span class="text-muted text-sm"> · {language.level}</span>
              </li>
            ))}
          </ul>
        </dd>
      </div>
      <div data-reveal style="--delay: 200ms">
        <dt class="text-muted font-mono text-sm">En dehors du code</dt>
        <dd class="mt-2">
          <ul class="space-y-1">
            {interests.map((interest) => (
              <li>{interest}</li>
            ))}
          </ul>
        </dd>
      </div>
    </dl>
  </Section>

  <Section id="contact" title="Contact">
    <p data-reveal class="max-w-2xl text-lg leading-relaxed">
      Une question, un échange autour d'un projet ? Écrivez-moi, je réponds rapidement.
    </p>
    <a
      data-reveal
      href={`mailto:${site.email}`}
      class="text-accent mt-6 inline-flex items-center gap-2 text-xl font-semibold hover:underline sm:text-2xl"
    >
      <Icon name="mail" class="size-5" />
      {site.email}
    </a>
    <div data-reveal class="mt-8 flex flex-wrap gap-3">
      <Button variant="secondary" href={site.cv} download>
        <Icon name="download" />
        CV (PDF)
      </Button>
      <Button variant="secondary" href={site.links.linkedin} target="_blank" rel="noopener">
        <Icon name="linkedin" />
        LinkedIn
      </Button>
      <Button variant="secondary" href={site.links.github} target="_blank" rel="noopener">
        <Icon name="github" />
        GitHub
      </Button>
    </div>
  </Section>
</BaseLayout>
