---
// Effet machine à écrire. Le texte complet reste dans le HTML : visible sans JS, lu d'un bloc par
// les lecteurs d'écran et indexé normalement. La partie pas encore écrite est seulement rendue
// invisible : elle garde sa place, rien ne bouge autour pendant la frappe.
import type { HTMLTag } from 'astro/types';

interface Props {
  text: string;
  as?: HTMLTag;
  class?: string;
  /** Délai avant la première lettre, en millisecondes. */
  delay?: number;
  /** Durée d'une lettre, en millisecondes. */
  speed?: number;
  /** Curseur laissé clignotant à la fin (dernière ligne d'une séquence). */
  lastLine?: boolean;
}

const {
  text,
  as: Tag = 'p',
  class: className,
  delay = 250,
  speed = 55,
  lastLine = false,
} = Astro.props;
---

<Tag class={className}>{text}</Tag>
<script is:inline define:vars={{ text, delay, speed, lastLine }}>
  (() => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const element = document.currentScript.previousElementSibling;
    const typed = document.createTextNode('');
    const cursor = document.createElement('span');
    const rest = document.createElement('span');
    cursor.className = 'typewriter-cursor';
    cursor.ariaHidden = 'true';
    rest.className = 'typewriter-rest';
    rest.textContent = text;
    element.replaceChildren(typed, rest);
    let length = 0;
    const type = () => {
      typed.data = text.slice(0, ++length);
      rest.textContent = text.slice(length);
      if (length < text.length) setTimeout(type, speed);
      else setTimeout(() => element.replaceChildren(text), lastLine ? 2500 : 0);
    };
    setTimeout(() => {
      element.insertBefore(cursor, rest);
      type();
    }, delay);
  })();
</script>
