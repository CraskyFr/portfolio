---
import Container from './Container.astro';

interface Props {
  id: string;
  title: string;
  /** Pastille affichée à côté du titre (ex. « En cours de construction »). */
  status?: string;
}

const { id, title, status } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="py-16">
  <Container>
    <h2
      data-reveal
      id={`${id}-title`}
      class="text-muted after:bg-border flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs font-semibold tracking-widest uppercase after:h-px after:flex-1"
    >
      <span class="whitespace-nowrap">{title}</span>
      {status && (
        <span class="border-border inline-flex items-center gap-1.5 rounded-full border border-dashed px-2.5 py-0.5 tracking-normal whitespace-nowrap normal-case">
          <span aria-hidden="true" class="bg-accent size-1.5 rounded-full" />
          {status}
        </span>
      )}
    </h2>
    <div class="mt-10">
      <slot />
    </div>
  </Container>
</section>
