---
import type { GetStaticPaths } from 'astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import CaseStudy from '../../components/CaseStudy.astro';
import Container from '../../components/Container.astro';
import { titleOf } from '../../data/experience';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Seules les missions phares ont une étude de cas détaillée. Depuis la frise, elle s'ouvre
// dans une carte ; cette page reste l'adresse partageable, indexée, et la solution sans JS.
export const getStaticPaths = (async () => {
  const experiences = await getCollection('experiences', ({ data }) => data.featured);
  return experiences.map((experience) => ({
    params: { slug: experience.id },
    props: { experience },
  }));
}) satisfies GetStaticPaths;

interface Props {
  experience: CollectionEntry<'experiences'>;
}

const { experience } = Astro.props;
---

<BaseLayout title={titleOf(experience)} description={experience.data.summary}>
  <span
    aria-hidden="true"
    class="reading-progress bg-accent fixed inset-x-0 top-0 z-50 h-0.5"
  ></span>
  <Container class="py-16 sm:py-20">
    <a href="/#experience" class="text-muted hover:text-accent text-sm transition-colors">
      ← Retour aux expériences
    </a>
    <div class="mt-8">
      <CaseStudy experience={experience} />
    </div>
  </Container>
</BaseLayout>
