---
import Icon from './Icon.astro';
---

<button
  type="button"
  data-theme-toggle
  class="text-muted hover:text-fg rounded-md p-2 transition-colors"
  aria-label="Basculer entre thème clair et sombre"
>
  <Icon name="moon" class="size-4 dark:hidden" />
  <Icon name="sun" class="hidden size-4 dark:block" />
</button>

<script>
  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const toggle = () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {}
      };

      // Sans View Transitions ou avec mouvements réduits : bascule immédiate.
      if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
        toggle();
        return;
      }

      // Le nouveau thème s'étend en cercle depuis le bouton jusqu'au coin le plus éloigné.
      const { left, top, width, height } = button.getBoundingClientRect();
      const x = left + width / 2;
      const y = top + height / 2;
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      document.startViewTransition(toggle).ready.then(() => {
        document.documentElement.animate(
          { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
          { duration: 450, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' },
        );
      });
    });
  });
</script>
